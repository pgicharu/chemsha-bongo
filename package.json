{
  "name": "chemsha-bongo",
  "version": "0.1.0",
  "description": "A Kahoot-style live trivia game, built to be monitored.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --import ./src/tracing.js src/server.js",
    "dev": "node --watch --import ./src/tracing.js src/server.js",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "migrate": "node src/migrate.js",
    "test": "node --test test/",
    "chaos": "node scripts/chaos.js",
    "bots": "node scripts/bots.js",
    "rescore": "node scripts/rescore.js"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "argon2": "0.45.1",
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/bungee": "5.3.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "pino-pretty": "13.2.0",
    "uqr": "0.1.3",
    "vite": "8.3.4"
  }
}
