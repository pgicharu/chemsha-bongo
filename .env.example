# Copy to .env (`make up` does this if .env is missing). Never commit .env.

# --- App ---------------------------------------------------------------------
# Public base URL, used in email links, e.g. https://chemsha.example.com
APP_BASE_URL=http://localhost:3000
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# Signs the session cookie: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ----------------------------------------------------------------
POSTGRES_USER=chemsha
POSTGRES_PASSWORD=chemsha
POSTGRES_DB=chemsha
# Host is the Compose service name, "postgres".
DATABASE_URL=postgres://chemsha:chemsha@postgres:5432/chemsha

# --- Email -------------------------------------------------------------------
# log (write links to the app log, event "email.logged") | smtp
EMAIL_TRANSPORT=log
MAIL_FROM="Chemsha Bongo <no-reply@chemsha.local>"
# SMTP server. Mailpit (make mail-up): mailpit:1025, no auth (localhost when
# the app runs outside Docker). Brevo: smtp-relay.brevo.com:587 with the SMTP
# login and key. SMTP_SECURE=true only for implicit TLS (port 465); 587 uses
# STARTTLS with false.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Monitoring --------------------------------------------------------------
# OTLP/HTTP endpoint; http://localhost:4318 when the app runs outside Docker.
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
OTEL_SERVICE_NAME=chemsha-bongo
# Password for grafana_reader, the read-only role Grafana uses; created by the
# app at start-up. Empty skips it. Outside a laptop: openssl rand -hex 24
GRAFANA_DB_PASSWORD=grafana-reader-local-only
# Rootless Docker only: container log dir and API socket.
#   DOCKER_CONTAINERS_DIR=/home/<you>/.local/share/docker/containers
#   DOCKER_SOCK=/run/user/<uid>/docker.sock

# --- Bot players -------------------------------------------------------------
# Shows "Add 5 bots" in the host's lobby. Set to false in production.
ALLOW_BOTS=true
# App URL for `npm run bots` / `make bots`.
BOTS_URL=http://localhost:3000
# Bots per game for `make traffic-up` (1-50).
# TRAFFIC_BOTS=15

# --- Fault injection (chaos switches) ----------------------------------------
# Empty disables the control endpoint. Otherwise: openssl rand -hex 24
# It listens on 127.0.0.1 in the app container; never publish or proxy it.
CHAOS_TOKEN=
# CHAOS_PORT=9091

# --- Production (docker-compose.prod.yml, DEPLOY.md) --------------------------
# Also change above: SESSION_SECRET, POSTGRES_PASSWORD (and in DATABASE_URL),
# GRAFANA_DB_PASSWORD, SMTP_*, MAIL_FROM, CHAOS_TOKEN. APP_BASE_URL,
# EMAIL_TRANSPORT and ALLOW_BOTS are set by docker-compose.prod.yml.
#
# Public hostnames; each needs a DNS record.
# APP_DOMAIN=quiz.example.com
# GRAFANA_DOMAIN=grafana.example.com
# Let's Encrypt contact address.
# ACME_EMAIL=you@example.com
# Initial Grafana admin password: openssl rand -base64 18
# GRAFANA_ADMIN_PASSWORD=
# Only if Uptime Kuma is published through Caddy (deploy/Caddyfile).
# UPTIME_DOMAIN=status.example.com
# Optional containers: uptime, netdata. Empty on a 2 GB server.
# COMPOSE_PROFILES=uptime,netdata
# Makes plain `docker compose` use the production files.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
