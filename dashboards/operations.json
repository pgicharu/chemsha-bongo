          },
          "expr": "process_resident_memory_bytes{job=\"chemsha-bongo\"}",
          "legendFormat": "resident (RSS)",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_heap_size_used_bytes{job=\"chemsha-bongo\"}",
          "legendFormat": "JS heap used",
