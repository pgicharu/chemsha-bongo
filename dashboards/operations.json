          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "sent / failed / logged. failed > 0 means the SMTP server refused or timed out."
    },
    {
      "id": 16,
      "title": "Process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
