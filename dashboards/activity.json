    {
      "id": 5,
      "title": "Sign-ups per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT date_trunc('day', created_at) AS time, count(*) AS \"sign-ups\"\nFROM users\nWHERE $__timeFilter(created_at)\n  AND NOT is_bot\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "New accounts per day (bots left out).",
      "interval": "1d"
    },
    {
      "id": 6,
      "title": "Quizzes created per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
