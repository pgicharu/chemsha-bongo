      "description": "New quizzes per day.",
      "interval": "1d"
    },
    {
      "id": 7,
      "title": "Attempts per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT date_trunc('day', started_at) AS time, count(*) AS \"attempts\"\nFROM attempts\nWHERE $__timeFilter(started_at)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
