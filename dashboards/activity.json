          },
          "rawSql": "SELECT date_trunc('day', created_at) AS time, count(*) AS \"quizzes\"\nFROM quizzes\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
